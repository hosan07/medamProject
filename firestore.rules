rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isChatParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);

      match /blocked/{targetUid} {
        allow read, write: if isOwner(uid);
      }

      match /following/{targetUid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }

      match /followers/{targetUid} {
        allow read: if signedIn();
        allow write: if signedIn();
      }

      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isDeleted == false
        && request.resource.data.isBlocked == false;
      allow update, delete: if signedIn()
        && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.isDeleted == false;
        allow update, delete: if signedIn()
          && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
      }

      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }

      match /scraps/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants;
      allow read, update, delete: if isChatParticipant();

      match /messages/{messageId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
