rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isChatParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    function isIncomingChatParticipant() {
      return signedIn() && request.auth.uid in request.resource.data.participants;
    }

    match /users/{uid} {
      // users/{uid}: read if authenticated, write if uid == request.auth.uid.
      allow read: if signedIn();
      allow write: if isOwner(uid);

      match /blocked/{targetUid} {
        // users/{uid}/blocked: read/write if uid == request.auth.uid.
        allow read, write: if isOwner(uid);
      }

      match /following/{targetUid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }

      match /followers/{targetUid} {
        allow read: if signedIn();
        allow write: if signedIn();
      }

      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    match /posts/{postId} {
      // posts: read if authenticated, create if authenticated and not blocked/deleted.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isDeleted == false
        && request.resource.data.isBlocked == false;
      allow update, delete: if signedIn()
        && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);

      match /comments/{commentId} {
        // posts/{postId}/comments: authenticated users can read/create comments.
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.isDeleted == false;
        allow update, delete: if signedIn()
          && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
      }

      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }

      match /scraps/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
    }

    match /food_logs/{uid}/daily/{date} {
      allow read, write: if isOwner(uid);

      match /meals/{mealId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /exercise_logs/{uid}/daily/{date} {
      allow read, write: if isOwner(uid);
    }

    match /chats/{chatId} {
      // chats/{chatId}: read/write only if request.auth.uid is in participants.
      allow create: if signedIn()
        && isIncomingChatParticipant();
      allow read, update, delete: if isChatParticipant();

      match /messages/{messageId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    match /reports/{reportId} {
      // reports: create only, no user reads.
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
